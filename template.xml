                        </item_prototype>
                        <item_prototype>
                            <uuid>a0410c10dfd144ccb8d8b37fced5e55c</uuid>
                            <name>Power Supply {#MODULE} Status</name>
                            <key>smpm.get[{#MODULE},Status]</key>
                            <history>365d</history>
                            <value_type>TEXT</value_type>
                            <trends>0</trends>
                            <description>IPMI Power Supply Module {#MODULE} Status</description>
                            <trigger_prototypes>
                                <trigger_prototype>
                                    <uuid>952aed69b3e243a4a7583dd095d7c26b</uuid>
                                    <expression>last(/sm_ipmi_powersupply/smpm.get[{#MODULE},Status])&lt;&gt;&quot;OK&quot;</expression>
                                    <name>Power Supply {#MODULE} Failed Status on {HOST.NAME}</name>
                                    <opdata>Current Status: {ITEM.LASTVALUE1}</opdata>
                                    <priority>HIGH</priority>
                                    <description>Power Supply Failed Status</description>
                                </trigger_prototype>
                            </trigger_prototypes>
                        </item_prototype>
                        <item_prototype>
                            <uuid>a772c2b13444467a840f8c0044a54d9e</uuid>
                            <name>Power Supply {#MODULE} Temperature 1</name>
                            <key>smpm.get[{#MODULE},Temperature 1]</key>
                            <history>365d</history>
                            <units>C</units>
                            <description>IPMI Power Supply Module {#MODULE} Temperature 1</description>
                            <trigger_prototypes>
                                <trigger_prototype>
                                    <uuid>f0bf24f34f2143aab8e32eec5f24d68a</uuid>
                                    <expression>abs(last(/sm_ipmi_powersupply/smpm.get[{#MODULE},Temperature 1]) - avg(/sm_ipmi_powersupply/smpm.get[{#MODULE},Temperature 1],#5)) &gt; (avg(/sm_ipmi_powersupply/smpm.get[{#MODULE},Temperature 1],#5) * 0.3)</expression>
                                    <name>Power Supply {#MODULE} Temp 1 Abnormal on {HOST.NAME}</name>
                                    <opdata>Value: {ITEM.LASTVALUE1} C</opdata>
                                    <priority>HIGH</priority>
                                    <description>Power Supply Temp 1 Abnormal</description>
                                </trigger_prototype>
                            </trigger_prototypes>
                        </item_prototype>
                        <item_prototype>
                            <uuid>46b85c729b3d47358f705db67a3cff5f</uuid>
                            <name>Power Supply {#MODULE} Temperature 2</name>
                            <key>smpm.get[{#MODULE},Temperature 2]</key>
                            <history>365d</history>
                            <units>C</units>
                            <description>IPMI Power Supply Module {#MODULE} Temperature 2</description>
                            <trigger_prototypes>
                                <trigger_prototype>
                                    <uuid>c08ab7948b9f45f6883eef436691f355</uuid>
                                    <expression>abs(last(/sm_ipmi_powersupply/smpm.get[{#MODULE},Temperature 2]) - avg(/sm_ipmi_powersupply/smpm.get[{#MODULE},Temperature 2],#5)) &gt; (avg(/sm_ipmi_powersupply/smpm.get[{#MODULE},Temperature 2],#5) * 0.3)</expression>
                                    <name>Power Supply {#MODULE} Temp 2 Abnormal on {HOST.NAME}</name>
                                    <opdata>Value: {ITEM.LASTVALUE1} C</opdata>
                                    <priority>HIGH</priority>
                                    <description>Power Supply Temp 2 Abnormal</description>
                                </trigger_prototype>
                            </trigger_prototypes>
                        </item_prototype>
                    </item_prototypes>
                    <graph_prototypes>
                        <graph_prototype>
                            <uuid>e48c052c75d244f9884830ba5660146d</uuid>
