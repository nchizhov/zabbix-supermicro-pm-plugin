                            <key>smpm.get[{#MODULE},Input Current]</key>
                            <history>365d</history>
                            <value_type>FLOAT</value_type>
                            <units>A</units>
                            <description>IPMI Power Supply Module {#MODULE} Input Current</description>
                        </item_prototype>
                        <item_prototype>
