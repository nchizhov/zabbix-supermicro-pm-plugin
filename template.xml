<?xml version="1.0" encoding="UTF-8"?>
<zabbix_export>
    <version>7.0</version>
    <template_groups>
        <template_group>
            <uuid>87306e1a49634bee802877643192b4cd</uuid>
            <name>IPMI</name>
        </template_group>
    </template_groups>
    <templates>
        <template>
            <uuid>dd99aa28a9b04cf6b2c31ecc7fa6e38a</uuid>
            <template>sm_ipmi_powersupply</template>
            <name>SuperMicro IPMI: Power Supply</name>
            <description>SuperMicro IPMI: Power Supply
===================

Author: Chizhov Nikolay
Repository: https://github.com/nchizhov/zabbix-supermicro-pm-plugin</description>
            <groups>
                <group>
                    <name>IPMI</name>
                </group>
            </groups>
            <discovery_rules>
                <discovery_rule>
                    <uuid>8eb98d1b08bf4fd5810cace46560e487</uuid>
                    <name>Power Supply Modules Discovery</name>
                    <key>smpm.discovery</key>
                    <delay>2h</delay>
                    <description>IPMI Power Supply Modules Discovery</description>
                    <item_prototypes>
                        <item_prototype>
                            <uuid>e267edd6a7774d66852eb2b85b82e18b</uuid>
                            <name>Power Supply {#MODULE} Fan 1 Speed</name>
                            <key>smpm.get[{#MODULE},Fan 1]</key>
                            <history>365d</history>
                            <units>RPM</units>
                            <description>IPMI Power Supply Module {#MODULE} Fan 1 Speed</description>
                            <trigger_prototypes>
                                <trigger_prototype>
                                    <uuid>fcef024e28864e26a9b622471a3075f5</uuid>
                                    <expression>abs(last(/sm_ipmi_powersupply/smpm.get[{#MODULE},Fan 1]) - avg(/sm_ipmi_powersupply/smpm.get[{#MODULE},Fan 1],#5)) &gt; (avg(/sm_ipmi_powersupply/smpm.get[{#MODULE},Fan 1],#5) * 0.3)</expression>
                                    <name>Power Supply {#MODULE} Fan 1 Speed Abnormal on {HOST.NAME}</name>
                                    <opdata>Value: {ITEM.LASTVALUE1} RPM</opdata>
                                    <priority>HIGH</priority>
                                    <description>Power Supply Fan 1 Speed Abnormal</description>
                                </trigger_prototype>
                            </trigger_prototypes>
                        </item_prototype>
                        <item_prototype>
                            <uuid>34d53e5f347c4a2ab986381e3b1caba3</uuid>
                            <name>Power Supply {#MODULE} Fan 2 Speed</name>
                            <key>smpm.get[{#MODULE},Fan 2]</key>
                            <history>365d</history>
                            <units>RPM</units>
                            <description>IPMI Power Supply Module {#MODULE} Fan 2 Speed</description>
                            <trigger_prototypes>
                                <trigger_prototype>
                                    <uuid>35a22646505e46b181ee37bb61d64bdf</uuid>
                                    <expression>abs(last(/sm_ipmi_powersupply/smpm.get[{#MODULE},Fan 2]) - avg(/sm_ipmi_powersupply/smpm.get[{#MODULE},Fan 2],#5)) &gt; (avg(/sm_ipmi_powersupply/smpm.get[{#MODULE},Fan 2],#5) * 0.3)</expression>
                                    <name>Power Supply {#MODULE} Fan 2 Speed Abnormal on {HOST.NAME}</name>
                                    <opdata>Value: {ITEM.LASTVALUE1} RPM</opdata>
                                    <priority>HIGH</priority>
                                    <description>Power Supply Fan 2 Speed Abnormal</description>
                                </trigger_prototype>
                            </trigger_prototypes>
                        </item_prototype>
                        <item_prototype>
                            <uuid>e3b753b2325e4776a6d359f635078c0f</uuid>
